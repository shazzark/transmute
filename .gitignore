# Transmute — version control exclusions
# Keep the repository free of build output, secrets, generated media, and machine-specific paths.

# --- Node / package manager -------------------------------------------------
node_modules/
.npm/
.npmrc.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.tsbuildinfo

# Lockfiles are intentionally committed; do not ignore package-lock.json.

# --- React Native / Metro / Expo --------------------------------------------
.metro-health-check*
.metro/
*.jsbundle
.expo/
.expo-shared/
expo-env.d.ts
dist/
web-build/
.history/

# --- Continuous native generation (Expo) ------------------------------------
# `android/` and `ios/` are generated by `npx expo prebuild` from the app config
# and are deliberately not committed. Regenerate them after changing app config
# or native plugins; keep native changes in a local module or config plugin.
/android/
/ios/
/b/
/g/
/r/
/s/

# --- Android build output ---------------------------------------------------
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/build.gradle.local
android/local.properties
android/captures/
android/.externalNativeBuild/
android/app/release/
android/.kotlin/

# Local Expo modules build in place under `modules/`; their Gradle output is
# generated exactly like the app's and never belongs in the repository.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
modules/*/android/.kotlin/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof
*.aar

# Gradle wrapper is not committed: `npx expo prebuild` generates it with the project.

# --- Signing material: never commit ------------------------------------------
*.keystore
*.jks
*.p12
*.pem
secrets.properties
key.properties

# --- Environment and local configuration ------------------------------------
.env
.env.*
!.env.example

# --- iOS (generated by `npx expo prebuild`; never committed) ----------------
ios/Pods/
ios/build/
ios/.xcode.env.local
*.xcuserdatad/
!ios/*.xcodeproj/project.pbxproj

# --- Tests and coverage -----------------------------------------------------
coverage/
.vitest/
vitest-report/
test-results/
junit.xml

# --- Maestro / Detox artifacts ----------------------------------------------
/maestro-artifacts/
/e2e/screenshots/
/e2e/videos/
.detox/
artifacts/

# --- Generated media fixtures ----------------------------------------------
# Fixtures are generated locally (see trd.md "Test strategy"), not committed.
/fixtures/
/test-media/
/media-samples/
# Guard against accidentally committing large binaries. Add an intentional
# asset later with `git add -f <path>` if one is ever required.
*.mp4
*.mkv
*.m4v
*.mov
*.webm
*.avi
*.flv
*.mpg
*.mpeg
*.3gp
*.mp3
*.aac
*.wav
*.flac
*.ogg
*.opus

# --- Local run logs ----------------------------------------------------------
# Build and install transcripts belong in a phase report, not in the repository.
/*.log

# --- Device verification dumps ----------------------------------------------
# `adb shell uiautomator dump` output and PID files written by local runs.
/ui*.xml
/*.pid

# --- Editor and OS ----------------------------------------------------------
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.orig
*.rej
